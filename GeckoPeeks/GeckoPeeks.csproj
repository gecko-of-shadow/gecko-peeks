<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets `dotnet publish -r win-x64` compile on Linux as well as Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Keep the published app one exe. Native desktop DLLs extract beside the process at runtime. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AssemblyName>GeckoPeeks</AssemblyName>
    <RootNamespace>GeckoPeeks</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyTitle>Gecko Peeks</AssemblyTitle>
    <Product>Gecko Peeks</Product>
    <Description>System-tray monitor for the route to Riot.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gecko-peeks.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Materialize the Win32 .ico from the text-safe base64 sibling before resources compile. -->
  <Target Name="MaterializeApplicationIcon" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_GeckoIconScript>$(MSBuildProjectDirectory)\Assets\Write-GeckoIcon.ps1</_GeckoIconScript>
    </PropertyGroup>
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -File &quot;$(_GeckoIconScript)&quot;"
          Condition="Exists('$(_GeckoIconScript)')" />
  </Target>
</Project>
