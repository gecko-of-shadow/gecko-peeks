<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AssemblyName>GeckoPeeks</AssemblyName>
    <RootNamespace>GeckoPeeks</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyTitle>Gecko Peeks</AssemblyTitle>
    <Product>Gecko Peeks</Product>
    <Description>System-tray monitor for the route to Riot.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\gecko-peeks.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Always rebuild the Win32 icon from the committed base64 (certutil is on windows-latest). -->
  <Target Name="MaterializeApplicationIcon" BeforeTargets="PrepareForBuild"
          Condition="Exists('$(MSBuildProjectDirectory)\Assets\gecko-peeks.ico.b64')">
    <Exec Command="certutil -decode &quot;$(MSBuildProjectDirectory)\Assets\gecko-peeks.ico.b64&quot; &quot;$(MSBuildProjectDirectory)\Assets\gecko-peeks.ico&quot;" />
  </Target>
</Project>
